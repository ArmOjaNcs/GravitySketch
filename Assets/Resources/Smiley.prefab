  text: 
  ru: "\u0414\u0440\u043E\u043D\u044B \u0431\u044B\u0432\u0430\u044E\u0442 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0442\u0438\u043F\u043E\u0432: \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u0438\u043A\u0438,
    \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u044B, \u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0438
    \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u0438"
  en: 'Drones come in different types: stormtroopers, snipers, bombers and destroyers'
