  text: 
  ru: "\u0426\u0438\u043A\u043B\u0438\u0447\u0435\u0441\u043A\u0438 \u043C\u0435\u043D\u044F\u0435\u0442
    \u0441\u0432\u043E\u0439 \u0440\u0430\u0437\u043C\u0435\u0440, \u043D\u0430\u043D\u043E\u0441\u0438\u0442
    \u0443\u0440\u043E\u043D, \u0435\u0441\u043B\u0438 \u0447\u0435\u0440\u043D\u0430\u044F
    \u0434\u044B\u0440\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432\u043D\u0443\u0442\u0440\u0438 \u0440\u0430\u0434\u0438\u0443\u0441\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F."
