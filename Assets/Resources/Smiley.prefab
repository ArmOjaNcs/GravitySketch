  text: 
  ru: "\u041F\u043E\u0433\u043B\u043E\u0449\u0430\u044F \u0446\u0432\u0435\u0442\u043D\u044B\u0435
    \u043A\u0443\u0431\u0438\u043A\u0438, \u0447\u0435\u0440\u043D\u0430\u044F \u0434\u044B\u0440\u0430
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
